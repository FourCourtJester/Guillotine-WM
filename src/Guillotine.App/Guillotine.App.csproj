<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area (tray) icon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the project build on Linux and macOS (it only runs on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Guillotine</AssemblyName>
    <RootNamespace>Guillotine.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\guillotine.ico</ApplicationIcon>
    <!-- WPF needs per-monitor DPI awareness from app.manifest; the Windows Forms analyzer prefers an API call. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and Windows Forms share type names (Application, Button, ...); keep WPF's in scope. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Guillotine.Core\Guillotine.Core.csproj" />
    <ProjectReference Include="..\Guillotine.Windows\Guillotine.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\guillotine.ico" Link="guillotine.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\settings.json" Link="settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
