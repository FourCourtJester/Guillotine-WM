<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Lets the project build on Linux and macOS (it only runs on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Guillotine</AssemblyName>
    <RootNamespace>Guillotine.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\guillotine.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Guillotine.Core\Guillotine.Core.csproj" />
    <ProjectReference Include="..\Guillotine.Windows\Guillotine.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\guillotine.ico" Link="guillotine.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\settings.json" Link="settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
