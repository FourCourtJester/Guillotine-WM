<ui:FluentWindow
    x:Class="Guillotine.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Guillotine"
    Icon="pack://application:,,,/guillotine.ico"
    Width="380"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    Loaded="OnLoaded"
    Activated="OnActivated"
    Deactivated="OnDeactivated"
    Closing="OnClosing"
    SizeChanged="OnSizeChanged"
    PreviewKeyDown="OnWindowPreviewKeyDown">

    <ui:FluentWindow.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="ZoneButton" TargetType="RadioButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="GroupName" Value="Zone" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </ui:FluentWindow.Resources>

    <StackPanel Margin="16,12,16,16">

        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Width="20" Height="20" Margin="0,0,8,0" Source="pack://application:,,,/guillotine.ico" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock x:Name="HeaderTitle" FontWeight="SemiBold" Text="Guillotine" />
                <TextBlock x:Name="AdminBadge" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Administrator" Visibility="Collapsed" />
            </StackPanel>
            <ui:Button Grid.Column="2" Appearance="Transparent" Padding="6" ToolTip="Hide (Esc)"
                       Icon="{ui:SymbolIcon Dismiss20}" Click="OnHideClicked" />
        </Grid>

        <!-- Target window -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="Window" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="WindowList" Grid.Column="0" SelectionChanged="OnWindowSelected">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding ProcessName, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="  " />
                            <Run Text="{Binding Title, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ui:Button Grid.Column="1" Margin="6,0,0,0" Padding="8" ToolTip="Refresh the window list"
                       Icon="{ui:SymbolIcon ArrowSync20}" Click="OnRefreshClicked" />
        </Grid>
        <TextBlock x:Name="WindowDetails" Style="{StaticResource Hint}" Margin="2,4,0,0" />

        <!-- Size -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="Client size" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:NumberBox x:Name="WidthBox" Grid.Column="0" Minimum="1" Maximum="32768" MaxDecimalPlaces="0"
                          SmallChange="1" LargeChange="10" PlaceholderText="Width" SpinButtonPlacementMode="Hidden" />
            <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Text="×" />
            <ui:NumberBox x:Name="HeightBox" Grid.Column="2" Minimum="1" Maximum="32768" MaxDecimalPlaces="0"
                          SmallChange="1" LargeChange="10" PlaceholderText="Height" SpinButtonPlacementMode="Hidden" />
        </Grid>
        <UniformGrid Margin="0,6,0,0" Rows="1">
            <ui:Button Margin="0,0,4,0" HorizontalAlignment="Stretch" Content="2560×1440" Tag="2560x1440" Click="OnPresetClicked" />
            <ui:Button Margin="2,0,2,0" HorizontalAlignment="Stretch" Content="1920×1080" Tag="1920x1080" Click="OnPresetClicked" />
            <ui:Button Margin="4,0,0,0" HorizontalAlignment="Stretch" Content="1280×720" Tag="1280x720" Click="OnPresetClicked" />
        </UniformGrid>

        <!-- Zone and switches side by side -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,6" Text="Zone" />
                <UniformGrid x:Name="ZoneGrid" Rows="3" Columns="3">
                    <RadioButton Style="{StaticResource ZoneButton}" Tag="top-left" Content="↖" ToolTip="Top left" />
                    <RadioButton Style="{StaticResource ZoneButton}" Tag="top" Content="↑" ToolTip="Top" />
                    <RadioButton Style="{StaticResource ZoneButton}" Tag="top-right" Content="↗" ToolTip="Top right" />
                    <RadioButton Style="{StaticResource ZoneButton}" Tag="left" Content="←" ToolTip="Left" />
                    <RadioButton Style="{StaticResource ZoneButton}" Tag="center" Content="●" ToolTip="Center" />
                    <RadioButton Style="{StaticResource ZoneButton}" Tag="right" Content="→" ToolTip="Right" />
                    <RadioButton Style="{StaticResource ZoneButton}" Tag="bottom-left" Content="↙" ToolTip="Bottom left" />
                    <RadioButton Style="{StaticResource ZoneButton}" Tag="bottom" Content="↓" ToolTip="Bottom" />
                    <RadioButton Style="{StaticResource ZoneButton}" Tag="bottom-right" Content="↘" ToolTip="Bottom right" />
                </UniformGrid>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,6" Text="Window options" />
                <ui:ToggleSwitch x:Name="BorderlessSwitch" Content="Borderless" Click="OnBorderlessClicked"
                                 ToolTip="Removes or restores the title bar and borders right away; the game picture stays put." />
                <ui:ToggleSwitch x:Name="TopmostSwitch" Margin="0,8,0,0" Content="Always on top" Click="OnTopmostClicked"
                                 ToolTip="Takes effect right away." />
                <ui:ToggleSwitch x:Name="WorkAreaSwitch" Margin="0,8,0,0" Content="Clear of taskbar"
                                 ToolTip="Used by Apply: compute zones from the space the taskbar leaves free." />
            </StackPanel>
        </Grid>

        <ui:InfoBar x:Name="Status" Margin="0,12,0,0" IsClosable="True" IsOpen="False" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Margin="0,0,4,0" HorizontalAlignment="Stretch" Content="Restore"
                       ToolTip="Put back the title bar and borders and turn off always on top"
                       Icon="{ui:SymbolIcon ArrowReset20}" Click="OnRestoreClicked" />
            <ui:Button Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Stretch" Appearance="Primary" Content="Apply"
                       ToolTip="Move and resize the window to the size and zone"
                       Icon="{ui:SymbolIcon Crop20}" Click="OnApplyClicked" />
        </Grid>

        <!-- App settings -->
        <Separator Margin="0,16,0,4" />
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Hotkey" />
                <TextBlock Style="{StaticResource Hint}" Text="Shows or hides this panel from anywhere" />
            </StackPanel>
            <ui:Button x:Name="HotkeyButton" Grid.Column="1" MinWidth="120" Icon="{ui:SymbolIcon Keyboard24}"
                       ToolTip="Click, then press a new key combination. Esc cancels, Backspace turns the hotkey off."
                       Click="OnHotkeyClicked" PreviewKeyDown="OnHotkeyPreviewKeyDown" LostKeyboardFocus="OnHotkeyLostFocus" />
        </Grid>
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Start with Windows" />
                <TextBlock x:Name="StartupHint" Style="{StaticResource Hint}" />
            </StackPanel>
            <ui:ToggleSwitch x:Name="StartupSwitch" Grid.Column="1" Click="OnStartupClicked" />
        </Grid>
    </StackPanel>
</ui:FluentWindow>
